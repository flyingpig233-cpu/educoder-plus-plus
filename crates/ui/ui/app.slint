import { ScrollView, Palette } from "std-widgets.slint";

export struct CourseRow { id: string, title: string }
export struct HomeworkRow { id: string, title: string, progress: string, completed: bool }
export struct EnvironmentRow { language: string, available: bool, detail: string }
export struct ConfettiParticle { x: float, drift: float, delay: float, speed: float, spin: float, size: float, color: color }

export global Theme {
    in-out property <bool> reduce-motion: false;
    in-out property <bool> dark: true;
    in-out property <int> accent-index: 0;
    out property <color> accent: accent-index == 1 ? (dark ? #8ab4f8 : #3569b5) : (accent-index == 2 ? (dark ? #c9a7ff : #7950b8) : text);
    out property <color> good: dark ? #64d98b : #18834b;
    out property <color> bad: dark ? #f28b82 : #bf2b2b;
    out property <color> canvas: dark ? #1c1c1c : #ffffff;
    out property <color> sidebar: dark ? #151515 : #f7f7f7;
    out property <color> surface: dark ? #242424 : #f5f5f5;
    out property <color> hover: dark ? #2c2c2c : #ebebeb;
    out property <color> line: dark ? #333333 : #e7e7e7;
    out property <color> text: dark ? #eeeeee : #202020;
    out property <color> muted: dark ? #a3a3a3 : #6b6b6b;
    out property <color> inverse: dark ? #191919 : #ffffff;
    out property <color> warning: dark ? #f1bda4 : #9b421f;
}

component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    in property <bool> selected: false;
    in property <bool> quiet: false;
    in property <bool> destructive: false;
    callback clicked;
    min-width: 72px;
    height: 36px;
    border-radius: 8px;
    border-width: root.quiet ? 0px : (focus.has-focus ? 2px : 1px);
    border-color: focus.has-focus ? Theme.muted : (root.primary || root.selected ? Theme.accent : Theme.line);
    background: root.primary ? Theme.accent : (touch.has-hover || root.selected || (root.quiet && focus.has-focus) ? Theme.hover : transparent);
    opacity: root.enabled ? 1 : 0.4;
    animate background, border-color, opacity { duration: Theme.reduce-motion ? 0ms : 120ms; easing: ease-in-out; }
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    HorizontalLayout {
        padding-left: root.quiet ? 12px : 0px;
        padding-right: root.quiet ? 12px : 0px;
        Text {
            text: root.text; color: root.destructive ? Theme.bad : (root.primary ? Theme.inverse : Theme.text);
            font-size: 13px; horizontal-alignment: root.quiet ? left : center; vertical-alignment: center;
        }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled; mouse-cursor: pointer;
        clicked => { focus.focus(); root.clicked(); }
    }
}

component PageArrow inherits Rectangle {
    in property <bool> next: false;
    in property <bool> enabled: true;
    callback clicked;
    width: 36px; height: 36px; background: transparent;
    opacity: root.enabled ? 1 : 0.3;
    accessible-role: button;
    accessible-label: root.next ? "下一页" : "上一页";
    accessible-action-default => { if root.enabled { root.clicked(); } }
    Image {
        x: 9px; y: 9px; width: 18px; height: 18px;
        source: root.next ? @image-url("../assets/arrow-right.svg") : @image-url("../assets/arrow-left.svg");
        colorize: touch.has-hover || focus.has-focus ? Theme.text : Theme.muted;
        animate colorize { duration: Theme.reduce-motion ? 0ms : 140ms; }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => { if e.text == " " || e.text == "\n" { root.clicked(); return accept; } return reject; }
    }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
}

component HomeworkTab inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <bool> enabled: true;
    callback clicked;
    width: 96px; height: 42px; background: transparent;
    opacity: root.enabled ? 1 : 0.4;
    accessible-role: button; accessible-label: root.text;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    Text {
        width: parent.width; height: parent.height - 3px;
        text: root.text; font-size: 16px; font-weight: root.selected ? 600 : 400;
        color: root.selected || touch.has-hover || focus.has-focus ? Theme.text : Theme.muted;
        horizontal-alignment: center; vertical-alignment: center;
        animate color { duration: Theme.reduce-motion ? 0ms : 140ms; }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => { if e.text == " " || e.text == "\n" { root.clicked(); return accept; } return reject; }
    }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
}

component RefreshButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> loading: false;
    private property <float> angle: 0;
    callback clicked;
    width: 36px; height: 36px;
    background: transparent;
    opacity: root.enabled || root.loading ? 1 : 0.4;
    animate opacity { duration: Theme.reduce-motion ? 0ms : 140ms; }
    accessible-role: button;
    accessible-label: root.loading ? root.label + "，正在加载" : root.label;
    accessible-action-default => { if root.enabled && !root.loading { root.clicked(); } }
    changed loading => { root.angle = 0; }
    Timer {
        interval: 16ms; running: root.loading && !Theme.reduce-motion;
        triggered => { root.angle = root.angle >= 354 ? 0 : root.angle + 6; }
    }
    Image {
        x: 9px; y: 9px; width: 18px; height: 18px;
        source: @image-url("../assets/refresh.svg");
        colorize: root.loading ? Theme.accent : (touch.has-hover || focus.has-focus ? Theme.text : Theme.muted);
        animate colorize { duration: Theme.reduce-motion ? 0ms : 140ms; }
        transform-rotation: root.angle * 1deg;
    }
    focus := FocusScope {
        enabled: root.enabled && !root.loading;
        key-pressed(e) => { if e.text == " " || e.text == "\n" { root.clicked(); return accept; } return reject; }
    }
    touch := TouchArea {
        enabled: root.enabled && !root.loading; mouse-cursor: pointer;
        clicked => { focus.focus(); root.clicked(); }
    }
}

component WindowButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> close-button: false;
    callback clicked;
    width: 44px; height: 46px;
    background: touch.has-hover || focus.has-focus ? (root.close-button ? #c42b1c : Theme.hover) : transparent;
    animate background { duration: Theme.reduce-motion ? 0ms : 100ms; }
    accessible-role: button; accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    Image {
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        width: 12px; height: 12px; source: root.icon; image-fit: contain;
        colorize: (touch.has-hover || focus.has-focus) && root.close-button ? white : Theme.text;
    }
    focus := FocusScope {
        key-pressed(e) => { if e.text == " " || e.text == "\n" { root.clicked(); return accept; } return reject; }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
}

component InputField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    callback edited(string);
    callback accepted;
    height: 40px;
    border-radius: 8px;
    border-width: 1px;
    border-color: input.has-focus ? Theme.muted : Theme.line;
    background: Theme.surface;
    animate border-color, background { duration: Theme.reduce-motion ? 0ms : 150ms; }
    Text {
        x: 12px; width: parent.width - 24px;
        visible: input.text == "";
        text: root.placeholder; color: Theme.muted; font-size: 13px;
        vertical-alignment: center;
    }
    input := TextInput {
        x: 12px; width: parent.width - 24px;
        text <=> root.text; color: Theme.text;
        selection-background-color: Theme.hover;
        selection-foreground-color: Theme.text;
        font-size: 13px; single-line: true; vertical-alignment: center;
        edited => { root.edited(self.text); }
        accepted => { root.accepted(); }
    }
}

component ConnectionIndicator inherits Rectangle {
    in property <bool> connected;
    in property <bool> connecting;
    in property <bool> failed;
    private property <bool> bright: true;
    private property <float> breath: root.bright ? 1 : 0.25;
    animate breath { duration: 900ms; easing: ease-in-out; }
    width: 9px; height: 9px; border-radius: 4.5px;
    background: root.connecting || root.connected ? Theme.good : (root.failed ? Theme.bad : transparent);
    border-width: 1.5px;
    border-color: root.connecting || root.connected ? Theme.good : (root.failed ? Theme.bad : Theme.muted);
    opacity: root.connecting ? root.breath : 1;
    accessible-role: text;
    accessible-label: root.connecting ? "正在连接" : (root.connected ? "连接成功" : (root.failed ? "连接失败" : "未登录"));
    changed connecting => { root.bright = true; }
    Timer { interval: 900ms; running: root.connecting; triggered => { root.bright = !root.bright; } }
}

export component AppWindow inherits Window {
    title: "Educoder++ · 工作台";
    no-frame: true;
    preferred-width: 1160px; preferred-height: 760px;
    min-width: 900px; min-height: 620px;
    default-font-family: "Microsoft YaHei UI";
    // Windows corners are clipped by the native window region. Keeping the
    // render target opaque avoids missing pixels with the software renderer.
    background: Theme.canvas;
    in-out property <bool> window-maximized: false;
    in-out property <bool> window-fullscreen: false;
    in-out property <bool> window-transitioning: false;
    private property <bool> window-expanded: root.window-maximized || root.window-fullscreen || root.window-transitioning;
    in-out property <image> user-avatar;
    in-out property <string> user-login;
    out property <bool> account-menu-open: account-menu.is-open;
    out property <float> account-menu-x: 16;
    out property <float> account-menu-y: root.height / 1px - 312;
    out property <float> account-menu-width: 226;
    out property <float> account-menu-height: 240;
    private property <float> account-menu-reveal: 0;
    animate account-menu-reveal {
        duration: root.reduce-motion || !account-menu.is-open ? 0ms : 180ms;
        easing: ease-out;
    }
    public function show-account-menu() {
        if !account-menu.is-open {
            root.account-menu-reveal = 0;
            account-menu.show();
            root.account-menu-reveal = 1;
        }
    }
    public function hide-account-menu() { if account-menu.is-open { account-menu.close(); } }
    in-out property <bool> dark-mode <=> Theme.dark;
    in-out property <int> theme-mode: 0; // 0: system, 1: light, 2: dark
    in-out property <bool> reduce-motion <=> Theme.reduce-motion;
    in-out property <bool> sidebar-collapsed: false;
    private property <float> sidebar-reveal: root.sidebar-collapsed ? 0 : 1;
    animate sidebar-reveal { duration: root.reduce-motion ? 0ms : 220ms; easing: ease-in-out; }
    public function toggle-sidebar() {
        root.hide-account-menu();
        root.sidebar-collapsed = !root.sidebar-collapsed;
    }
    in-out property <float> page-reveal: 1;
    in-out property <bool> celebration-active: false;
    in-out property <int> celebration-id: 0;
    in-out property <string> celebration-game;
    in-out property <float> celebration-progress: 0;
    in-out property <[ConfettiParticle]> confetti;
    in-out property <bool> connected: false;
    in-out property <bool> connecting: false;
    in-out property <bool> connection-failed: false;
    in-out property <bool> has-session: false;
    in-out property <int> page: 0;
    in-out property <int> settings-return-page: 0;
    in-out property <int> accent-index <=> Theme.accent-index;
    in-out property <string> web-message;
    in-out property <int> web-sequence: 0;
    out property <float> web-x: (sidebar.width + 1px) / 1px;
    out property <float> web-y: 46;
    out property <float> web-width: root.width / 1px - root.web-x - 6;
    out property <float> web-height: root.height / 1px - 52;
    in-out property <string> c-compiler: "gcc";
    in-out property <string> cpp-compiler: "g++";
    in-out property <string> rust-compiler: "rustc";
    in-out property <string> python-interpreter: "python";
    in-out property <string> js-interpreter: "node";
    in-out property <string> java-runtime: "java";
    in-out property <string> java-compiler: "javac";
    in-out property <[EnvironmentRow]> environments;
    in-out property <bool> checking-environment: false;
    callback open-homework(string);
    callback web-event(string);
    callback save-settings;
    callback inspect-environment;
    callback drag-window;
    callback resize-window(int);
    callback minimize-window;
    callback maximize-window;
    callback close-window;
    in-out property <bool> busy: false;
    private property <int> refresh-target: 0;
    changed busy => { if !root.busy { root.refresh-target = 0; } }
    in-out property <bool> workspace-busy: false;
    in-out property <bool> login-open: false;
    in-out property <bool> browser-login-open: false;
    in-out property <bool> login-reading: false;
    callback start-browser-login;
    callback finish-browser-login;
    callback cancel-browser-login;
    in-out property <string> user-name: "访客";
    in-out property <string> course-title: "课堂作业";
    in-out property <string> selected-course-id;
    in-out property <string> course-query;
    in-out property <string> notice;
    in-out property <string> cache-status;
    in-out property <string> error-message;
    in-out property <string> page-label: "第 1 页";
    in-out property <bool> can-previous: false;
    in-out property <bool> can-next: false;
    in-out property <bool> has-course: false;
    in-out property <int> kind: 0;
    in-out property <[CourseRow]> courses;
    in-out property <[HomeworkRow]> homeworks;
    callback select-course(string);
    callback search-courses(string);
    callback change-kind(int);
    callback change-page(int);
    callback refresh;
    callback refresh-courses;
    callback retry;
    callback logout;
    changed dark-mode => { Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light; }
    init => { Palette.color-scheme = ColorScheme.dark; }

    Rectangle {
      width: parent.width; height: parent.height;
      border-radius: root.window-expanded ? 0px : 12px;
      clip: true; background: Theme.canvas;
    VerticalLayout {
      spacing: 0px;
      Rectangle {
        height: 46px; background: Theme.sidebar;
        HorizontalLayout {
          spacing: 0px;
          Rectangle {
            horizontal-stretch: 1;
            HorizontalLayout {
              padding-left: 20px; spacing: 14px;
              Rectangle {
                width: 22px;
                Image {
                  width: 22px; height: 22px; y: (parent.height - self.height) / 2;
                  source: @image-url("../assets/app-icon.svg"); image-fit: contain;
                }
              }
              Text { text: "Educoder++"; font-size: 13px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
              Rectangle { horizontal-stretch: 1; }
              Rectangle { width: 16px; }
            }
            TouchArea {
              pointer-event(event) => { if event.kind == PointerEventKind.down && event.button == PointerEventButton.left { root.drag-window(); } }
              double-clicked => { root.maximize-window(); }
            }
          }
          WindowButton { icon: @image-url("../assets/window-minimize.svg"); label: "最小化"; clicked => { root.minimize-window(); } }
          WindowButton { icon: root.window-maximized ? @image-url("../assets/window-restore.svg") : @image-url("../assets/window-maximize.svg"); label: root.window-maximized ? "还原" : "最大化"; clicked => { root.maximize-window(); } }
          WindowButton { icon: @image-url("../assets/window-close.svg"); label: "关闭"; close-button: true; clicked => { root.close-window(); } }
        }
      }
      HorizontalLayout {
        spacing: 0px;
        sidebar := Rectangle {
            width: 64px + root.sidebar-reveal * 194px;
            horizontal-stretch: 0; background: Theme.sidebar; clip: true;
            Rectangle {
              y: 56px; width: 258px; height: parent.height - 56px;
              opacity: root.sidebar-reveal;
              visible: root.sidebar-reveal > 0;
            VerticalLayout {
                padding: 20px; spacing: 16px;
                ScrollView {
                    vertical-stretch: 1; content-width: self.width;
                    VerticalLayout {
                        spacing: 6px;
                        for course in root.courses: Rectangle {
                            height: 46px; border-radius: 8px;
                            border-width: course-focus.has-focus ? 1px : 0px;
                            border-color: Theme.muted;
                            background: root.selected-course-id == course.id ? Theme.hover : (course-touch.has-hover ? Theme.surface : transparent);
                            animate background { duration: Theme.reduce-motion ? 0ms : 130ms; }
                            accessible-role: button; accessible-label: course.title;
                            accessible-action-default => { if root.has-session && !root.login-open { root.select-course(course.id); } }
                            course-focus := FocusScope {
                                enabled: root.has-session && !root.login-open;
                                key-pressed(event) => {
                                    if event.text == " " || event.text == "\n" { root.select-course(course.id); return accept; }
                                    return reject;
                                }
                            }
                            Text {
                                x: 12px; width: parent.width - 24px;
                                text: course.title; color: Theme.text; font-size: 13px;
                                overflow: elide; vertical-alignment: center;
                            }
                            course-touch := TouchArea {
                                enabled: root.has-session && !root.login-open; mouse-cursor: pointer;
                                clicked => { course-focus.focus(); root.select-course(course.id); }
                            }
                        }
                        if root.courses.length == 0: Text {
                            text: root.has-session ? "暂无课堂" : "连接后显示你的课堂";
                            color: Theme.muted; font-size: 12px; wrap: word-wrap;
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
                Rectangle { height: 1px; background: Theme.line; }
                Rectangle {
                    height: 52px; border-radius: 10px;
                    background: avatar-touch.has-hover || avatar-focus.has-focus || account-menu.is-open ? Theme.hover : transparent;
                    accessible-role: button; accessible-label: "打开账号菜单";
                    accessible-action-default => { root.show-account-menu(); }
                    Image { x: 8px; y: 7px; width: 38px; height: 38px; source: root.user-avatar.width > 0 ? root.user-avatar : @image-url("../assets/avatar-placeholder.svg"); image-fit: cover; }
                    Text { x: 58px; width: parent.width - 104px; height: parent.height; text: root.user-name; font-size: 13px; font-weight: 600; color: Theme.text; vertical-alignment: center; overflow: elide; }
                    Image { x: parent.width - 42px; y: 20px; width: 12px; height: 12px; source: @image-url("../assets/chevron-up.svg"); colorize: Theme.muted; }
                    ConnectionIndicator { x: parent.width - 21px; y: 21.5px; connected: root.connected; connecting: root.connecting; failed: root.connection-failed; }
                    avatar-focus := FocusScope {
                        key-pressed(e) => { if e.text == " " || e.text == "\n" { root.show-account-menu(); return accept; } return reject; }
                    }
                    avatar-touch := TouchArea { mouse-cursor: pointer; clicked => { avatar-focus.focus(); if account-menu.is-open { account-menu.close(); } else { root.show-account-menu(); } } }
                }
            }
            }
            Text {
                x: 20px; y: 20px; width: 136px; height: 36px;
                text: "我的课堂"; color: Theme.muted; font-size: 16px; font-weight: 600;
                vertical-alignment: center; opacity: root.sidebar-reveal;
            }
            Rectangle {
                width: 64px; height: parent.height;
                opacity: 1 - root.sidebar-reveal;
                visible: root.sidebar-reveal < 1;
                Text {
                    x: 20px; y: 84px; width: 24px; height: 100px;
                    text: "我\n的\n课\n堂"; color: Theme.muted; font-size: 16px; font-weight: 600;
                    horizontal-alignment: center; vertical-alignment: center;
                }
                Rectangle {
                    x: 8px; y: parent.height - 72px; width: 48px; height: 52px;
                    border-radius: 10px;
                    background: rail-touch.has-hover || rail-focus.has-focus || account-menu.is-open ? Theme.hover : transparent;
                    accessible-role: button; accessible-label: "打开账号菜单";
                    accessible-action-default => { root.show-account-menu(); }
                    Image {
                        x: 5px; y: 7px; width: 38px; height: 38px;
                        source: root.user-avatar.width > 0 ? root.user-avatar : @image-url("../assets/avatar-placeholder.svg"); image-fit: cover;
                    }
                    rail-focus := FocusScope {
                        enabled: root.sidebar-collapsed;
                        key-pressed(e) => { if e.text == " " || e.text == "\n" { root.show-account-menu(); return accept; } return reject; }
                    }
                    ConnectionIndicator { x: 39px; y: 35px; connected: root.connected; connecting: root.connecting; failed: root.connection-failed; }
                    rail-touch := TouchArea { enabled: root.sidebar-collapsed; mouse-cursor: pointer; clicked => { rail-focus.focus(); if account-menu.is-open { account-menu.close(); } else { root.show-account-menu(); } } }
                }
            }
            RefreshButton {
                x: 164px; y: 20px; opacity: root.sidebar-reveal;
                visible: root.sidebar-reveal > 0;
                label: "刷新课堂"; enabled: root.connected && !root.busy && !root.sidebar-collapsed;
                loading: root.busy && root.refresh-target == 1;
                clicked => { root.refresh-target = 1; root.refresh-courses(); }
            }
            Rectangle {
                x: parent.width - 50px; y: 20px; width: 36px; height: 36px;
                border-radius: 8px;
                background: toggle-touch.has-hover || toggle-focus.has-focus ? Theme.hover : transparent;
                animate background { duration: Theme.reduce-motion ? 0ms : 120ms; }
                accessible-role: button;
                accessible-label: root.sidebar-collapsed ? "展开我的课堂" : "收起我的课堂";
                accessible-action-default => { root.toggle-sidebar(); }
                Image {
                    x: 9px; y: 9px; width: 18px; height: 18px;
                    source: @image-url("../assets/sidebar-toggle.svg"); colorize: Theme.muted;
                    transform-rotation: (1 - root.sidebar-reveal) * 180deg;
                }
                toggle-focus := FocusScope {
                    key-pressed(e) => { if e.text == " " || e.text == "\n" { root.toggle-sidebar(); return accept; } return reject; }
                }
                toggle-touch := TouchArea { mouse-cursor: pointer; clicked => { toggle-focus.focus(); root.toggle-sidebar(); } }
            }
        }
        Rectangle { width: 1px; background: Theme.line; }
        if root.page == 0: Rectangle {
          opacity: root.page-reveal;
            horizontal-stretch: 1; background: Theme.canvas;
            VerticalLayout {
                width: 100%; height: 100%;
                padding: 32px; spacing: 22px;
                HorizontalLayout {
                    height: 24px;
                    Text { text: "工作台   /   我的课堂"; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                }
                HorizontalLayout {
                    height: 66px; spacing: 20px;
                    VerticalLayout {
                        spacing: 6px;
                        Text { text: root.course-title; font-size: 26px; font-weight: 600; color: Theme.text; overflow: elide; }
                        Text { text: root.has-course ? "在这里查看课堂布置的作业。" : "把课堂和作业集中在一个安静的工作空间。"; font-size: 13px; color: Theme.muted; }
                    }
                    Rectangle {
                        width: 36px;
                        RefreshButton {
                            y: (parent.height - self.height) / 2;
                            label: "刷新作业"; enabled: root.connected && !root.busy;
                            loading: root.busy && root.refresh-target == 2;
                            clicked => { root.refresh-target = 2; root.refresh(); }
                        }
                    }
                }
                Rectangle {
                    height: 42px;
                    HorizontalLayout {
                        width: parent.width; height: parent.height; spacing: 16px;
                        shixun-tab := HomeworkTab { text: "实训作业"; selected: root.kind == 0; enabled: root.has-course; clicked => { root.change-kind(0); } }
                        text-tab := HomeworkTab { text: "图文作业"; selected: root.kind == 1; enabled: root.has-course; clicked => { root.change-kind(1); } }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: root.homeworks.length + " 项作业"; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                    }
                    Rectangle {
                        x: (root.kind == 0 ? shixun-tab.x : text-tab.x) + 12px;
                        y: parent.height - 2px; width: 72px; height: 2px;
                        border-radius: 1px; background: Theme.accent;
                        opacity: root.has-course ? 1 : 0.4;
                        animate x { duration: Theme.reduce-motion ? 0ms : 220ms; easing: ease-in-out; }
                    }
                }
                if root.notice != "": Text { text: root.notice; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                if root.error-message != "": Rectangle {
                    min-height: 66px; border-radius: 10px; background: Theme.surface;
                    HorizontalLayout {
                        padding: 14px; spacing: 12px;
                        Text { text: root.error-message; color: Theme.warning; font-size: 13px; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
                        ActionButton { text: "重试"; enabled: !root.busy; clicked => { root.retry(); } }
                    }
                }
                Rectangle { height: 1px; background: Theme.line; }
                if root.homeworks.length > 0: ScrollView {
                    vertical-stretch: 1; content-width: self.width;
                    VerticalLayout {
                        spacing: 10px;
                        for homework in root.homeworks: Rectangle {
                            accessible-role: button; accessible-label: homework.title;
                            accessible-action-default => { root.open-homework(homework.id); }
                            height: 80px; border-radius: 12px; clip: true; border-width: 1px;
                            border-color: Theme.line;
                            background: homework-touch.has-hover || homework-focus.has-focus ? Theme.hover : Theme.canvas;
                            animate background { duration: Theme.reduce-motion ? 0ms : 140ms; }
                            HorizontalLayout {
                                padding: 18px; spacing: 16px;
                                Text { horizontal-stretch: 1; text: homework.title; font-size: 14px; font-weight: 500; color: Theme.text; overflow: elide; vertical-alignment: center; }
                                Rectangle {
                                    width: 76px;
                                    Rectangle {
                                        width: 76px; height: 26px; y: (parent.height - self.height) / 2;
                                        border-radius: 6px; background: homework.completed ? (Theme.dark ? #254d35 : #d9efdf) : Theme.surface;
                                        Text { text: homework.progress; color: homework.completed ? Theme.good : Theme.muted; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
                            }
                            homework-focus := FocusScope {
                                key-pressed(e) => { if e.text == " " || e.text == "\n" { root.open-homework(homework.id); return accept; } return reject; }
                            }
                            homework-touch := TouchArea { mouse-cursor: pointer; clicked => { homework-focus.focus(); root.open-homework(homework.id); } }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
                if root.homeworks.length == 0: Rectangle {
                    vertical-stretch: 1;
                    VerticalLayout {
                        width: 100%; height: 100%;
                        alignment: center; spacing: 16px;
                        if root.busy || root.has-session: Text { text: root.busy ? "···" : "▤"; color: Theme.muted; font-size: 40px; horizontal-alignment: center; }
                        if !root.busy && !root.has-session: HorizontalLayout {
                            alignment: center;
                            Image {
                                width: 52px; height: 52px;
                                source: @image-url("../assets/app-icon.svg"); image-fit: contain;
                            }
                        }
                        Text { text: root.busy ? "正在获取课堂数据" : (!root.has-session ? "从你的课堂开始" : (root.error-message != "" ? "暂时无法显示作业" : (root.has-course ? "这一页还没有作业" : "选择一个课堂"))); color: Theme.text; font-size: 20px; font-weight: 500; horizontal-alignment: center; }
                        Text { text: root.busy ? "加载完成后，作业会显示在这里。" : (!root.has-session ? "登录头歌账号，即可浏览课堂和作业。" : "可以切换课堂、作业类型或刷新列表。"); color: Theme.muted; font-size: 13px; horizontal-alignment: center; }
                        if !root.has-session && !root.busy: HorizontalLayout {
                            alignment: center;
                            ActionButton { width: 146px; text: "连接头歌账号"; primary: true; clicked => { root.login-open = true; root.error-message = ""; } }
                        }
                    }
                }
                if root.has-course: HorizontalLayout {
                    height: 36px; spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    PageArrow { enabled: root.can-previous && !root.busy; clicked => { root.change-page(-1); } }
                    PageArrow { next: true; enabled: root.can-next && !root.busy; clicked => { root.change-page(1); } }
                }
            }
        }
        if root.page == 1: Rectangle {
          opacity: root.page-reveal;
          horizontal-stretch: 1; background: Theme.canvas;
          ScrollView {
            content-width: self.width;
            VerticalLayout {
              padding: 32px; spacing: 18px;
              HorizontalLayout {
                Text { text: "设置"; font-size: 26px; font-weight: 600; color: Theme.text; }
                ActionButton { width: 110px; text: "返回工作台"; clicked => { root.page = root.settings-return-page; } }
              }
              Text { text: "外观"; font-size: 16px; color: Theme.text; }
              HorizontalLayout {
                spacing: 10px;
                ActionButton { text: "跟随系统"; selected: root.theme-mode == 0; clicked => { root.theme-mode = 0; } }
                ActionButton { text: "深色"; selected: root.theme-mode == 2; clicked => { root.theme-mode = 2; root.dark-mode = true; } }
                ActionButton { text: "浅色"; selected: root.theme-mode == 1; clicked => { root.theme-mode = 1; root.dark-mode = false; } }
                Rectangle { horizontal-stretch: 1; }
              }
              Text { text: "强调色"; font-size: 13px; color: Theme.muted; }
              HorizontalLayout {
                spacing: 10px;
                ActionButton { text: "灰阶"; selected: root.accent-index == 0; clicked => { root.accent-index = 0; } }
                ActionButton { text: "蓝色"; selected: root.accent-index == 1; clicked => { root.accent-index = 1; } }
                ActionButton { text: "紫色"; selected: root.accent-index == 2; clicked => { root.accent-index = 2; } }
                Rectangle { horizontal-stretch: 1; }
              }
              Rectangle { height: 1px; background: Theme.line; }
              Text { text: "本地编译环境"; font-size: 16px; color: Theme.text; }
              Text { text: "使用 PATH 中的程序名或编译器/解释器的绝对路径。"; color: Theme.muted; font-size: 12px; }
              HorizontalLayout { spacing: 12px; Text { text: "C"; width: 100px; color: Theme.text; vertical-alignment: center; } InputField { text <=> root.c-compiler; } }
              HorizontalLayout { spacing: 12px; Text { text: "C++"; width: 100px; color: Theme.text; vertical-alignment: center; } InputField { text <=> root.cpp-compiler; } }
              HorizontalLayout { spacing: 12px; Text { text: "Rust"; width: 100px; color: Theme.text; vertical-alignment: center; } InputField { text <=> root.rust-compiler; } }
              HorizontalLayout { spacing: 12px; Text { text: "Python"; width: 100px; color: Theme.text; vertical-alignment: center; } InputField { text <=> root.python-interpreter; } }
              HorizontalLayout { spacing: 12px; Text { text: "JavaScript"; width: 100px; color: Theme.text; vertical-alignment: center; } InputField { text <=> root.js-interpreter; } }
              HorizontalLayout { spacing: 12px; Text { text: "Java / javac"; width: 100px; color: Theme.text; vertical-alignment: center; } InputField { text <=> root.java-runtime; } InputField { text <=> root.java-compiler; } }
              HorizontalLayout {
                spacing: 12px;
                ActionButton { text: "保存设置"; primary: true; clicked => { root.save-settings(); } }
                ActionButton { text: root.checking-environment ? "正在检查…" : "检查编译环境"; enabled: !root.checking-environment; clicked => { root.inspect-environment(); } }
                Rectangle { horizontal-stretch: 1; }
              }
              for env in root.environments: Text { text: env.language + " · " + env.detail; color: env.available ? Theme.good : Theme.bad; font-size: 12px; wrap: word-wrap; }
              if root.notice != "": Text { text: root.notice; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
              if root.error-message != "": Text { text: root.error-message; color: Theme.bad; font-size: 12px; wrap: word-wrap; }
              Rectangle { vertical-stretch: 1; }
            }
          }
        }
        if root.page == 2: Rectangle {
          horizontal-stretch: 1; background: Theme.canvas;
          Text { text: "正在启动代码工作区…"; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
        }
      }
    }

    if !root.window-expanded: TouchArea { x: 0px; y: 0px; width: 5px; height: parent.height; mouse-cursor: ew-resize; pointer-event(e) => { if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { root.resize-window(0); } } }
    if !root.window-expanded: TouchArea { x: parent.width - 5px; y: 0px; width: 5px; height: parent.height; mouse-cursor: ew-resize; pointer-event(e) => { if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { root.resize-window(1); } } }
    if !root.window-expanded: TouchArea { x: 0px; y: parent.height - 5px; width: parent.width; height: 5px; mouse-cursor: ns-resize; pointer-event(e) => { if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { root.resize-window(2); } } }
    if !root.window-expanded: TouchArea { x: 0px; y: 0px; width: parent.width; height: 5px; mouse-cursor: ns-resize; pointer-event(e) => { if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { root.resize-window(3); } } }
    if root.login-open: Rectangle {
        background: #00000088;
        TouchArea { }
        if !root.browser-login-open: Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: 560px; height: 340px;
            border-radius: 16px; background: Theme.canvas; border-width: 1px; border-color: Theme.line;
            VerticalLayout {
                padding: 28px; spacing: 18px;
                Text { text: "连接你的头歌账号"; color: Theme.text; font-size: 22px; font-weight: 600; }
                Text { text: "使用微信扫描头歌官方二维码，确认登录后点击「已完成登录」，验证并保存会话。"; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
                ActionButton { text: "微信扫码登录"; primary: true; enabled: !root.busy; clicked => { root.start-browser-login(); } }
                Text { text: "登录成功后，会话将保存在系统凭据库中。"; color: Theme.muted; font-size: 12px; }
                if root.error-message != "": Text { text: root.error-message; color: Theme.warning; font-size: 12px; wrap: word-wrap; max-height: 48px; overflow: elide; }
                HorizontalLayout {
                    spacing: 10px; alignment: end;
                    ActionButton { text: "取消"; enabled: !root.busy; clicked => { root.login-open = false; } }
                }
            }
        }
        if root.browser-login-open: Rectangle {
            x: 24px; y: 60px; width: root.width - 48px; height: root.height - 84px;
            border-radius: 12px; background: Theme.canvas; border-width: 1px; border-color: Theme.line;
            VerticalLayout {
                padding: 16px; spacing: 12px;
                Text { height: 32px; text: "微信扫码登录 · 确认后点击「已完成登录」"; color: Theme.text; font-size: 15px; font-weight: 600; }
                Rectangle { vertical-stretch: 1; background: #ffffff; }
                HorizontalLayout {
                    height: 44px; spacing: 12px;
                    Text { horizontal-stretch: 1; text: root.error-message != "" ? root.error-message : "请使用微信扫一扫，并在手机上确认登录。"; color: root.error-message != "" ? Theme.warning : Theme.muted; wrap: word-wrap; font-size: 12px; }
                    ActionButton { text: "取消"; enabled: !root.busy; clicked => { root.cancel-browser-login(); } }
                    ActionButton { width: 140px; text: root.busy || root.login-reading ? "正在验证…" : "已完成登录"; primary: true; enabled: !root.busy && !root.login-reading; clicked => { root.finish-browser-login(); } }
                }
            }
        }
    }
    }

    if root.celebration-active && !root.reduce-motion: Rectangle {
        width: parent.width; height: parent.height; clip: true;
        for particle in root.confetti: Rectangle {
            visible: root.celebration-progress >= particle.delay && (root.page != 2 || self.x < root.web-x * 1px || self.y < 46px || self.x > root.width - 6px || self.y > root.height - 6px);
            x: particle.x * root.width + particle.drift * root.celebration-progress * 60px;
            y: (root.celebration-progress - particle.delay) * particle.speed * (root.height + 60px) - 40px;
            width: particle.size * 1px; height: particle.size * 0.55px;
            background: particle.color;
            transform-rotation: particle.spin * root.celebration-progress * 1deg;
        }
    }
    if root.celebration-active && root.page != 2: Rectangle {
        x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
        width: 220px; height: 150px;
        opacity: min(1, root.celebration-progress * 12) * min(1, (1 - root.celebration-progress) * 7);
        VerticalLayout { alignment: center; spacing: 4px;
            Text { text: "AC"; font-size: 72px; font-weight: 900; color: Theme.good; horizontal-alignment: center; }
            Text { text: "Accepted · 全部测试通过"; font-size: 14px; color: Theme.text; horizontal-alignment: center; }
        }
    }
    Rectangle {
        width: parent.width; height: parent.height;
        background: transparent; border-width: root.window-expanded ? 0px : 1px;
        border-color: root.dark-mode ? #656565 : #b4b4b4;
        border-radius: root.window-expanded ? 0px : 12px;
    }
    account-menu := PopupWindow {
        x: root.account-menu-x * 1px; y: root.account-menu-y * 1px;
        width: root.account-menu-width * 1px; height: root.account-menu-height * 1px;
        close-policy: close-on-click-outside;
        Rectangle {
            width: parent.width; height: 232px;
            y: (1 - root.account-menu-reveal) * 8px;
            opacity: root.account-menu-reveal;
            border-radius: 12px; background: Theme.surface;
            border-width: 1px; border-color: Theme.line;
            VerticalLayout {
                padding: 10px; spacing: 6px;
                HorizontalLayout {
                    height: 52px; spacing: 10px; padding-left: 8px;
                    Rectangle {
                        width: 38px; height: 52px;
                        Image { y: 7px; width: 38px; height: 38px; source: root.user-avatar.width > 0 ? root.user-avatar : @image-url("../assets/avatar-placeholder.svg"); image-fit: cover; }
                    }
                    VerticalLayout {
                        spacing: 3px; alignment: center;
                        Text { text: root.user-name; color: Theme.text; font-size: 13px; font-weight: 600; overflow: elide; }
                        Text { text: root.has-session ? "@" + root.user-login : "Educoder++"; color: Theme.muted; font-size: 11px; overflow: elide; }
                    }
                }
                Rectangle { height: 1px; background: Theme.line; }
                ActionButton { text: "设置"; quiet: true; clicked => { account-menu.close(); if root.page != 1 { root.settings-return-page = root.page; } root.page = 1; } }
                ActionButton { text: root.has-session ? "切换账号" : "连接头歌账号"; quiet: true; enabled: !root.busy && !root.workspace-busy; clicked => { account-menu.close(); root.login-open = true; root.error-message = ""; } }
                Rectangle { height: 1px; background: Theme.line; }
                ActionButton { text: "退出登录"; quiet: true; destructive: true; enabled: root.has-session && !root.busy && !root.workspace-busy; clicked => { account-menu.close(); root.logout(); } }
            }
        }
    }
}
