import { ScrollView, Palette } from "std-widgets.slint";

export struct CourseRow { id: string, title: string }
export struct HomeworkRow { id: string, title: string, subtitle: string, badge: string }
export struct EnvironmentRow { language: string, available: bool, detail: string }
export struct ConfettiParticle { x: float, drift: float, delay: float, speed: float, spin: float, size: float, color: color }

export global Theme {
    in-out property <bool> reduce-motion: false;
    in-out property <bool> dark: true;
    in-out property <int> accent-index: 0;
    out property <color> accent: accent-index == 1 ? (dark ? #8ab4f8 : #3569b5) : (accent-index == 2 ? (dark ? #c9a7ff : #7950b8) : text);
    out property <color> good: dark ? #64d98b : #18834b;
    out property <color> bad: dark ? #f28b82 : #bf2b2b;
    out property <color> canvas: dark ? #1c1c1c : #ffffff;
    out property <color> sidebar: dark ? #151515 : #f7f7f7;
    out property <color> surface: dark ? #242424 : #f5f5f5;
    out property <color> hover: dark ? #2c2c2c : #ebebeb;
    out property <color> line: dark ? #333333 : #e7e7e7;
    out property <color> text: dark ? #eeeeee : #202020;
    out property <color> muted: dark ? #a3a3a3 : #6b6b6b;
    out property <color> inverse: dark ? #191919 : #ffffff;
    out property <color> warning: dark ? #f1bda4 : #9b421f;
}

component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    in property <bool> selected: false;
    in property <bool> quiet: false;
    in property <bool> destructive: false;
    callback clicked;
    min-width: 72px;
    height: 36px;
    border-radius: 8px;
    border-width: root.quiet ? 0px : (focus.has-focus ? 2px : 1px);
    border-color: focus.has-focus ? Theme.muted : (root.primary || root.selected ? Theme.accent : Theme.line);
    background: root.primary ? Theme.accent : (touch.has-hover || root.selected || (root.quiet && focus.has-focus) ? Theme.hover : transparent);
    opacity: root.enabled ? 1 : 0.4;
    animate background, border-color, opacity { duration: Theme.reduce-motion ? 0ms : 120ms; easing: ease-in-out; }
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    HorizontalLayout {
        padding-left: root.quiet ? 12px : 0px;
        padding-right: root.quiet ? 12px : 0px;
        Text {
            text: root.text; color: root.destructive ? Theme.bad : (root.primary ? Theme.inverse : Theme.text);
            font-size: 13px; horizontal-alignment: root.quiet ? left : center; vertical-alignment: center;
        }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled; mouse-cursor: pointer;
        clicked => { focus.focus(); root.clicked(); }
    }
}

component WindowButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> close-button: false;
    callback clicked;
    width: 44px; height: 46px;
    background: touch.has-hover || focus.has-focus ? (root.close-button ? #c42b1c : Theme.hover) : transparent;
    animate background { duration: Theme.reduce-motion ? 0ms : 100ms; }
    accessible-role: button; accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    Image {
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        width: 12px; height: 12px; source: root.icon; image-fit: contain;
        colorize: (touch.has-hover || focus.has-focus) && root.close-button ? white : Theme.text;
    }
    focus := FocusScope {
        key-pressed(e) => { if e.text == " " || e.text == "\n" { root.clicked(); return accept; } return reject; }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
}

component InputField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    callback edited(string);
    callback accepted;
    height: 40px;
    border-radius: 8px;
    border-width: 1px;
    border-color: input.has-focus ? Theme.muted : Theme.line;
    background: Theme.surface;
    animate border-color, background { duration: Theme.reduce-motion ? 0ms : 150ms; }
    Text {
        x: 12px; width: parent.width - 24px;
        visible: input.text == "";
        text: root.placeholder; color: Theme.muted; font-size: 13px;
        vertical-alignment: center;
    }
    input := TextInput {
        x: 12px; width: parent.width - 24px;
        text <=> root.text; color: Theme.text;
        selection-background-color: Theme.hover;
        selection-foreground-color: Theme.text;
        font-size: 13px; single-line: true; vertical-alignment: center;
        edited => { root.edited(self.text); }
        accepted => { root.accepted(); }
    }
}

export component AppWindow inherits Window {
    title: "Educoder++ · 工作台";
    no-frame: true;
    preferred-width: 1160px; preferred-height: 760px;
    min-width: 900px; min-height: 620px;
    default-font-family: "Microsoft YaHei UI";
    // Windows corners are clipped by the native window region. Keeping the
    // render target opaque avoids missing pixels with the software renderer.
    background: Theme.canvas;
    in-out property <bool> window-maximized: false;
    in-out property <image> user-avatar;
    in-out property <string> user-login;
    out property <bool> account-menu-open: account-menu.is-open;
    public function show-account-menu() { account-menu.show(); }
    public function hide-account-menu() { if account-menu.is-open { account-menu.close(); } }
    in-out property <bool> dark-mode <=> Theme.dark;
    in-out property <int> theme-mode: 0; // 0: system, 1: light, 2: dark
    in-out property <bool> reduce-motion <=> Theme.reduce-motion;
    in-out property <float> page-reveal: 1;
    in-out property <bool> celebration-active: false;
    in-out property <int> celebration-id: 0;
    in-out property <string> celebration-game;
    in-out property <float> celebration-progress: 0;
    in-out property <[ConfettiParticle]> confetti;
    in-out property <bool> connected: false;
    in-out property <bool> has-session: false;
    in-out property <int> page: 0;
    in-out property <int> settings-return-page: 0;
    in-out property <int> accent-index <=> Theme.accent-index;
    in-out property <string> web-message;
    in-out property <int> web-sequence: 0;
    out property <float> web-x: 259;
    out property <float> web-y: 46;
    out property <float> web-width: root.width / 1px - 265;
    out property <float> web-height: root.height / 1px - 52;
    in-out property <string> c-compiler: "gcc";
    in-out property <string> cpp-compiler: "g++";
    in-out property <string> rust-compiler: "rustc";
    in-out property <string> python-interpreter: "python";
    in-out property <string> js-interpreter: "node";
    in-out property <string> java-runtime: "java";
    in-out property <string> java-compiler: "javac";
    in-out property <[EnvironmentRow]> environments;
    in-out property <bool> checking-environment: false;
    callback open-homework(string);
    callback web-event(string);
    callback save-settings;
    callback inspect-environment;
    callback drag-window;
    callback resize-window(int);
    callback minimize-window;
    callback maximize-window;
    callback close-window;
    in-out property <bool> busy: false;
    in-out property <bool> workspace-busy: false;
    in-out property <bool> login-open: false;
    in-out property <string> cookie-path;
    in-out property <string> user-name: "尚未连接头歌";
    in-out property <string> course-title: "课堂作业";
    in-out property <string> selected-course-id;
    in-out property <string> course-query;
    in-out property <string> notice;
    in-out property <string> cache-status;
    in-out property <string> error-message;
    in-out property <string> page-label: "第 1 页";
    in-out property <bool> can-previous: false;
    in-out property <bool> can-next: false;
    in-out property <bool> has-course: false;
    in-out property <int> kind: 0;
    in-out property <[CourseRow]> courses;
    in-out property <[HomeworkRow]> homeworks;
    callback import-session(string);
    callback select-course(string);
    callback search-courses(string);
    callback change-kind(int);
    callback change-page(int);
    callback refresh;
    callback refresh-courses;
    callback retry;
    callback logout;
    changed dark-mode => { Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light; }
    init => { Palette.color-scheme = ColorScheme.dark; }

    Rectangle {
      width: parent.width; height: parent.height;
      border-radius: root.window-maximized ? 0px : 12px;
      clip: true; background: Theme.canvas;
    VerticalLayout {
      spacing: 0px;
      Rectangle {
        height: 46px; background: Theme.sidebar;
        HorizontalLayout {
          spacing: 0px;
          Rectangle {
            horizontal-stretch: 1;
            HorizontalLayout {
              padding-left: 20px; spacing: 14px;
              Text { text: "E"; font-size: 18px; font-weight: 700; color: Theme.text; vertical-alignment: center; }
              Text { text: "Educoder++"; font-size: 13px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
              Rectangle { horizontal-stretch: 1; }
              Text { text: root.connected ? "●  已连接头歌" : "●  未连接"; color: root.connected ? Theme.good : Theme.bad; font-size: 12px; vertical-alignment: center; }
              Rectangle { width: 16px; }
            }
            TouchArea {
              pointer-event(event) => { if event.kind == PointerEventKind.down && event.button == PointerEventButton.left { root.drag-window(); } }
              double-clicked => { root.maximize-window(); }
            }
          }
          WindowButton { icon: @image-url("../assets/window-minimize.svg"); label: "最小化"; clicked => { root.minimize-window(); } }
          WindowButton { icon: root.window-maximized ? @image-url("../assets/window-restore.svg") : @image-url("../assets/window-maximize.svg"); label: root.window-maximized ? "还原" : "最大化"; clicked => { root.maximize-window(); } }
          WindowButton { icon: @image-url("../assets/window-close.svg"); label: "关闭"; close-button: true; clicked => { root.close-window(); } }
        }
      }
      HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: 258px; background: Theme.sidebar;
            VerticalLayout {
                padding: 20px; spacing: 16px;
                HorizontalLayout {
                    height: 36px;
                    Text { text: "我的课堂"; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                    ActionButton { text: "刷新课堂"; enabled: root.connected && !root.busy; clicked => { root.refresh-courses(); } }
                }
                InputField {
                    text <=> root.course-query; placeholder: "搜索课堂…";
                    edited(text) => { root.search-courses(text); }
                }
                ScrollView {
                    vertical-stretch: 1; content-width: self.width;
                    VerticalLayout {
                        spacing: 6px;
                        for course in root.courses: Rectangle {
                            height: 46px; border-radius: 8px;
                            border-width: course-focus.has-focus ? 1px : 0px;
                            border-color: Theme.muted;
                            background: root.selected-course-id == course.id ? Theme.hover : (course-touch.has-hover ? Theme.surface : transparent);
                            animate background { duration: Theme.reduce-motion ? 0ms : 130ms; }
                            accessible-role: button; accessible-label: course.title;
                            accessible-action-default => { if root.has-session && !root.login-open { root.select-course(course.id); } }
                            course-focus := FocusScope {
                                enabled: root.has-session && !root.login-open;
                                key-pressed(event) => {
                                    if event.text == " " || event.text == "\n" { root.select-course(course.id); return accept; }
                                    return reject;
                                }
                            }
                            Text {
                                x: 12px; width: parent.width - 24px;
                                text: course.title; color: Theme.text; font-size: 13px;
                                overflow: elide; vertical-alignment: center;
                            }
                            course-touch := TouchArea {
                                enabled: root.has-session && !root.login-open; mouse-cursor: pointer;
                                clicked => { course-focus.focus(); root.select-course(course.id); }
                            }
                        }
                        if root.courses.length == 0: Text {
                            text: root.has-session ? "没有匹配的课堂" : "连接后显示你的课堂";
                            color: Theme.muted; font-size: 12px; wrap: word-wrap;
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
                Rectangle { height: 1px; background: Theme.line; }
                Rectangle {
                    height: 52px; border-radius: 10px;
                    background: avatar-touch.has-hover || avatar-focus.has-focus || account-menu.is-open ? Theme.hover : transparent;
                    accessible-role: button; accessible-label: "打开账号菜单";
                    accessible-action-default => { account-menu.show(); }
                    Image { x: 8px; y: 7px; width: 38px; height: 38px; source: root.user-avatar.width > 0 ? root.user-avatar : @image-url("../assets/avatar-placeholder.svg"); image-fit: cover; }
                    Text { x: 58px; width: parent.width - 86px; height: parent.height; text: root.user-name; font-size: 13px; font-weight: 600; color: Theme.text; vertical-alignment: center; overflow: elide; }
                    Image { x: parent.width - 24px; y: 20px; width: 12px; height: 12px; source: @image-url("../assets/chevron-up.svg"); colorize: Theme.muted; }
                    avatar-focus := FocusScope {
                        key-pressed(e) => { if e.text == " " || e.text == "\n" { account-menu.show(); return accept; } return reject; }
                    }
                    avatar-touch := TouchArea { mouse-cursor: pointer; clicked => { avatar-focus.focus(); if account-menu.is-open { account-menu.close(); } else { account-menu.show(); } } }
                }
            }
        }
        Rectangle { width: 1px; background: Theme.line; }
        if root.page == 0: Rectangle {
          opacity: root.page-reveal;
            horizontal-stretch: 1; background: Theme.canvas;
            VerticalLayout {
                padding: 32px; spacing: 22px;
                HorizontalLayout {
                    height: 24px;
                    Text { text: "工作台   /   我的课堂"; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                    Text { text: root.busy ? "正在后台同步…" : ""; color: Theme.muted; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
                }
                HorizontalLayout {
                    height: 66px; spacing: 20px;
                    VerticalLayout {
                        spacing: 6px;
                        Text { text: root.course-title; font-size: 26px; font-weight: 600; color: Theme.text; overflow: elide; }
                        Text { text: root.has-course ? "在这里查看课堂布置的作业。" : "把课堂和作业集中在一个安静的工作空间。"; font-size: 13px; color: Theme.muted; }
                    }
                    ActionButton { width: 84px; text: "↻  刷新"; enabled: root.connected && !root.busy; clicked => { root.refresh(); } }
                }
                HorizontalLayout {
                    height: 36px; spacing: 8px;
                    ActionButton { text: "实训作业"; selected: root.kind == 0; enabled: root.has-course; clicked => { root.change-kind(0); } }
                    ActionButton { text: "图文作业"; selected: root.kind == 1; enabled: root.has-course; clicked => { root.change-kind(1); } }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: root.homeworks.length + " 项作业"; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                }
                if root.notice != "": Text { text: root.notice; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                if root.cache-status != "": Text { text: root.cache-status; color: Theme.muted; font-size: 11px; }
                if root.error-message != "": Rectangle {
                    min-height: 66px; border-radius: 10px; background: Theme.surface;
                    HorizontalLayout {
                        padding: 14px; spacing: 12px;
                        Text { text: root.error-message; color: Theme.warning; font-size: 13px; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
                        ActionButton { text: "重试"; enabled: !root.busy; clicked => { root.retry(); } }
                    }
                }
                Rectangle { height: 1px; background: Theme.line; }
                ScrollView {
                    visible: root.homeworks.length > 0;
                    vertical-stretch: 1; content-width: self.width;
                    VerticalLayout {
                        spacing: 10px;
                        for homework in root.homeworks: Rectangle {
                            accessible-role: button; accessible-label: homework.title;
                            accessible-action-default => { root.open-homework(homework.id); }
                            height: 96px; border-radius: 12px; border-width: 1px; border-color: Theme.line; background: Theme.canvas;
                            HorizontalLayout {
                                padding: 18px; spacing: 16px;
                                Rectangle {
                                    width: 36px; height: 36px; border-radius: 9px; background: Theme.surface;
                                    Text { text: root.kind == 0 ? "</>" : "≡"; color: Theme.muted; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                VerticalLayout {
                                    spacing: 7px; horizontal-stretch: 1;
                                    Text { text: homework.title; font-size: 14px; font-weight: 500; color: Theme.text; overflow: elide; vertical-alignment: center; }
                                    Text { text: homework.subtitle; font-size: 12px; color: Theme.muted; overflow: elide; }
                                }
                                Rectangle {
                                    width: 76px; height: 26px; border-radius: 6px; background: Theme.surface;
                                    Text { text: homework.badge; color: Theme.muted; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                            TouchArea { mouse-cursor: pointer; clicked => { root.open-homework(homework.id); } }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
                if root.homeworks.length == 0: Rectangle {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: center; spacing: 16px;
                        Text { text: root.busy ? "···" : (root.has-session ? "▤" : "E"); color: Theme.muted; font-size: 40px; horizontal-alignment: center; }
                        Text { text: root.busy ? "正在获取课堂数据" : (!root.has-session ? "从你的课堂开始" : (root.error-message != "" ? "暂时无法显示作业" : (root.has-course ? "这一页还没有作业" : "选择一个课堂"))); color: Theme.text; font-size: 20px; font-weight: 500; horizontal-alignment: center; }
                        Text { text: root.busy ? "加载完成后，作业会显示在这里。" : (!root.has-session ? "导入登录文件，即可浏览课堂和作业。" : "可以切换课堂、作业类型或刷新列表。"); color: Theme.muted; font-size: 13px; horizontal-alignment: center; }
                        if !root.has-session && !root.busy: HorizontalLayout {
                            alignment: center;
                            ActionButton { width: 146px; text: "连接头歌账号"; primary: true; clicked => { root.login-open = true; root.error-message = ""; } }
                        }
                    }
                }
                if root.has-course: HorizontalLayout {
                    height: 36px; spacing: 8px;
                    Text { text: root.page-label; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    ActionButton { text: "上一页"; enabled: root.can-previous && !root.busy; clicked => { root.change-page(-1); } }
                    ActionButton { text: "下一页"; enabled: root.can-next && !root.busy; clicked => { root.change-page(1); } }
                }
            }
        }
        if root.page == 1: Rectangle {
          opacity: root.page-reveal;
          horizontal-stretch: 1; background: Theme.canvas;
          ScrollView {
            content-width: self.width;
            VerticalLayout {
              padding: 32px; spacing: 18px;
              HorizontalLayout {
                Text { text: "设置"; font-size: 26px; font-weight: 600; color: Theme.text; }
                ActionButton { width: 110px; text: "返回工作台"; clicked => { root.page = root.settings-return-page; } }
              }
              Text { text: "外观"; font-size: 16px; color: Theme.text; }
              HorizontalLayout {
                spacing: 10px;
                ActionButton { text: "跟随系统"; selected: root.theme-mode == 0; clicked => { root.theme-mode = 0; } }
                ActionButton { text: "深色"; selected: root.theme-mode == 2; clicked => { root.theme-mode = 2; root.dark-mode = true; } }
                ActionButton { text: "浅色"; selected: root.theme-mode == 1; clicked => { root.theme-mode = 1; root.dark-mode = false; } }
                Rectangle { horizontal-stretch: 1; }
              }
              Text { text: "强调色"; font-size: 13px; color: Theme.muted; }
              HorizontalLayout {
                spacing: 10px;
                ActionButton { text: "灰阶"; selected: root.accent-index == 0; clicked => { root.accent-index = 0; } }
                ActionButton { text: "蓝色"; selected: root.accent-index == 1; clicked => { root.accent-index = 1; } }
                ActionButton { text: "紫色"; selected: root.accent-index == 2; clicked => { root.accent-index = 2; } }
                Rectangle { horizontal-stretch: 1; }
              }
              Rectangle { height: 1px; background: Theme.line; }
              Text { text: "本地编译环境"; font-size: 16px; color: Theme.text; }
              Text { text: "使用 PATH 中的程序名或编译器/解释器的绝对路径。"; color: Theme.muted; font-size: 12px; }
              HorizontalLayout { spacing: 12px; Text { text: "C"; width: 100px; color: Theme.text; vertical-alignment: center; } InputField { text <=> root.c-compiler; } }
              HorizontalLayout { spacing: 12px; Text { text: "C++"; width: 100px; color: Theme.text; vertical-alignment: center; } InputField { text <=> root.cpp-compiler; } }
              HorizontalLayout { spacing: 12px; Text { text: "Rust"; width: 100px; color: Theme.text; vertical-alignment: center; } InputField { text <=> root.rust-compiler; } }
              HorizontalLayout { spacing: 12px; Text { text: "Python"; width: 100px; color: Theme.text; vertical-alignment: center; } InputField { text <=> root.python-interpreter; } }
              HorizontalLayout { spacing: 12px; Text { text: "JavaScript"; width: 100px; color: Theme.text; vertical-alignment: center; } InputField { text <=> root.js-interpreter; } }
              HorizontalLayout { spacing: 12px; Text { text: "Java / javac"; width: 100px; color: Theme.text; vertical-alignment: center; } InputField { text <=> root.java-runtime; } InputField { text <=> root.java-compiler; } }
              HorizontalLayout {
                spacing: 12px;
                ActionButton { text: "保存设置"; primary: true; clicked => { root.save-settings(); } }
                ActionButton { text: root.checking-environment ? "正在检查…" : "检查编译环境"; enabled: !root.checking-environment; clicked => { root.inspect-environment(); } }
                Rectangle { horizontal-stretch: 1; }
              }
              for env in root.environments: Text { text: env.language + " · " + env.detail; color: env.available ? Theme.good : Theme.bad; font-size: 12px; wrap: word-wrap; }
              if root.notice != "": Text { text: root.notice; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
              if root.error-message != "": Text { text: root.error-message; color: Theme.bad; font-size: 12px; wrap: word-wrap; }
              Rectangle { vertical-stretch: 1; }
            }
          }
        }
        if root.page == 2: Rectangle {
          horizontal-stretch: 1; background: Theme.canvas;
          Text { text: "正在启动代码工作区…"; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
        }
      }
    }

    TouchArea { x: 0px; y: 0px; width: 5px; height: parent.height; mouse-cursor: ew-resize; pointer-event(e) => { if e.kind == PointerEventKind.down { root.resize-window(0); } } }
    TouchArea { x: parent.width - 5px; y: 0px; width: 5px; height: parent.height; mouse-cursor: ew-resize; pointer-event(e) => { if e.kind == PointerEventKind.down { root.resize-window(1); } } }
    TouchArea { x: 0px; y: parent.height - 5px; width: parent.width; height: 5px; mouse-cursor: ns-resize; pointer-event(e) => { if e.kind == PointerEventKind.down { root.resize-window(2); } } }
    TouchArea { x: 0px; y: 0px; width: parent.width; height: 5px; mouse-cursor: ns-resize; pointer-event(e) => { if e.kind == PointerEventKind.down { root.resize-window(3); } } }
    if root.login-open: Rectangle {
        background: #00000088;
        TouchArea { }
        Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: 520px; height: 330px;
            border-radius: 16px; background: Theme.canvas; border-width: 1px; border-color: Theme.line;
            VerticalLayout {
                padding: 28px; spacing: 18px;
                Text { text: "连接你的头歌账号"; color: Theme.text; font-size: 22px; font-weight: 600; }
                Text { text: "在浏览器登录头歌后，导出 cookies.txt，\n然后在下方填入文件路径。"; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
                InputField {
                    text <=> root.cookie-path; placeholder: "例如 C:\\private\\cookies.txt";
                    accepted => { if !root.busy && root.cookie-path != "" { root.import-session(root.cookie-path); } }
                }
                Text { text: "登录成功后，会话将保存在系统凭据库中。"; color: Theme.muted; font-size: 12px; }
                if root.error-message != "": Text { text: root.error-message; color: Theme.warning; font-size: 12px; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 10px; alignment: end;
                    ActionButton { text: "取消"; enabled: !root.busy; clicked => { root.login-open = false; root.cookie-path = ""; } }
                    ActionButton { width: 130px; text: root.busy ? "正在连接…" : "导入并连接"; primary: true; enabled: !root.busy && root.cookie-path != ""; clicked => { root.import-session(root.cookie-path); } }
                }
            }
        }
    }
    }

    if root.celebration-active && !root.reduce-motion: Rectangle {
        width: parent.width; height: parent.height; clip: true;
        for particle in root.confetti: Rectangle {
            visible: root.celebration-progress >= particle.delay && (root.page != 2 || self.x < 259px || self.y < 46px || self.x > root.width - 6px || self.y > root.height - 6px);
            x: particle.x * root.width + particle.drift * root.celebration-progress * 60px;
            y: (root.celebration-progress - particle.delay) * particle.speed * (root.height + 60px) - 40px;
            width: particle.size * 1px; height: particle.size * 0.55px;
            background: particle.color;
            transform-rotation: particle.spin * root.celebration-progress * 1deg;
        }
    }
    if root.celebration-active && root.page != 2: Rectangle {
        x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
        width: 220px; height: 150px;
        opacity: min(1, root.celebration-progress * 12) * min(1, (1 - root.celebration-progress) * 7);
        VerticalLayout { alignment: center; spacing: 4px;
            Text { text: "AC"; font-size: 72px; font-weight: 900; color: Theme.good; horizontal-alignment: center; }
            Text { text: "Accepted · 全部测试通过"; font-size: 14px; color: Theme.text; horizontal-alignment: center; }
        }
    }
    Rectangle {
        width: parent.width; height: parent.height;
        background: transparent; border-width: 1px;
        border-color: root.dark-mode ? #656565 : #b4b4b4;
        border-radius: root.window-maximized ? 0px : 12px;
    }
    account-menu := PopupWindow {
        x: 16px; y: root.height - 312px; width: 226px; height: 232px;
        close-policy: close-on-click-outside;
        Rectangle {
            border-radius: 12px; background: Theme.surface;
            border-width: 1px; border-color: Theme.line;
            VerticalLayout {
                padding: 10px; spacing: 6px;
                HorizontalLayout {
                    height: 52px; spacing: 10px; padding-left: 8px;
                    Rectangle {
                        width: 38px; height: 52px;
                        Image { y: 7px; width: 38px; height: 38px; source: root.user-avatar.width > 0 ? root.user-avatar : @image-url("../assets/avatar-placeholder.svg"); image-fit: cover; }
                    }
                    VerticalLayout {
                        spacing: 3px; alignment: center;
                        Text { text: root.user-name; color: Theme.text; font-size: 13px; font-weight: 600; overflow: elide; }
                        Text { text: root.has-session ? "@" + root.user-login : "连接你的头歌账号"; color: Theme.muted; font-size: 11px; overflow: elide; }
                    }
                }
                Rectangle { height: 1px; background: Theme.line; }
                ActionButton { text: "设置"; quiet: true; clicked => { account-menu.close(); if root.page != 1 { root.settings-return-page = root.page; } root.page = 1; } }
                ActionButton { text: root.has-session ? "切换账号" : "连接头歌账号"; quiet: true; enabled: !root.busy && !root.workspace-busy; clicked => { account-menu.close(); root.login-open = true; root.cookie-path = ""; root.error-message = ""; } }
                Rectangle { height: 1px; background: Theme.line; }
                ActionButton { text: "退出登录"; quiet: true; destructive: true; enabled: root.has-session && !root.busy && !root.workspace-busy; clicked => { account-menu.close(); root.logout(); } }
            }
        }
    }
}
